{
  "name": "mng-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:seo",
    "build": "vite build",
    "preview": "vite preview",
    "generate:seo": "node scripts/generate-seo-assets.mjs",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "qa:matrix:responsive": "node scripts/qa-responsive-matrix.mjs",
    "qa:cross-browser": "node scripts/qa-cross-browser.mjs",
    "qa:accessibility": "node scripts/qa-accessibility.mjs",
    "migrate:publications": "node scripts/migrate-publications.mjs",
    "migrate:gallery": "node scripts/migrate-gallery.mjs",
    "localize:wix-images": "node scripts/localize-wix-images.mjs",
    "verify:members": "node scripts/verify-members.mjs",
    "verify:routes:published": "node scripts/verify-published-routes.mjs --write-report",
    "verify:rollback:deploy": "node scripts/verify-rollback-deploy.mjs",
    "check:pages:status": "node scripts/check-pages-status.mjs",
    "preflight:p5": "node scripts/p5-preflight.mjs",
    "validate:redirects": "node scripts/validate-redirects.mjs --write-report",
    "validate:content": "node scripts/validate-content.mjs --write-report",
    "validate:content:urls": "node scripts/validate-content.mjs --check-urls --write-report",
    "admin:dev": "vite --config admin/vite.config.js",
    "admin:build": "vite build --config admin/vite.config.js",
    "admin:preview": "vite preview --config admin/vite.config.js",
    "admin:test": "node --test admin/tests/model.test.mjs admin/tests/auth.test.mjs admin/tests/github.test.mjs admin/tests/requests.test.mjs admin/tests/management.test.mjs admin/tests/restore.test.mjs && npm run admin:build && node admin/tests/smoke.mjs",
    "admin:build:auth": "VITE_ADMIN_AUTH=required vite build --config admin/vite.config.js",
    "admin:test:connected": "npm run admin:build:auth && node admin/tests/connected-smoke.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "jose": "6.2.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.11.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  }
}

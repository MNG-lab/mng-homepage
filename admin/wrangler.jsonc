{
  "name": "admin",
  "account_id": "aaabcbaeabd689d5c50a0f07348d6634",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist-admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "11644955871",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "11644955872",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "11644955873",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://admin.mng-lab.workers.dev",
    "GITHUB_REPOSITORY": "MNG-lab/mng-homepage",
    "GITHUB_WORKFLOW_REF": "main",
    "GITHUB_ENABLED": "true",
    "MEMBERS_DB": "true",
    "ADMIN_ENV": "production",
    "GITHUB_BASE": "main"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mng-admin",
      "database_id": "eb83b146-a930-4155-8c1d-c426ac856aa0",
      "migrations_dir": "migrations"
    }
  ],
  "build": {
    "command": "npm run admin:build:production"
  }
}
